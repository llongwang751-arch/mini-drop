{
  "schema": "mini-drop.skill-evolution-adapter.v1",
  "purpose": "Run different diagnostic agents under the same stateful adversarial campaign.",
  "required_operations": [
    "learn_from_verified_diagnosis",
    "select_probe_for_incident",
    "record_diagnosis_feedback",
    "get_strategy_status",
    "publish_new_strategy_version",
    "rollback_strategy_version",
    "admit_evidence_backed_strategy"
  ],
  "required_observation_fields": [
    "step_id",
    "selected_action",
    "strategy_id",
    "strategy_version",
    "strategy_status",
    "evidence_refs",
    "decision_reason"
  ],
  "forbidden_inputs": [
    "private_oracle",
    "expected_action",
    "expected_root_cause",
    "case_specific_answer_map"
  ],
  "comparison_metrics": [
    "sequence_pass_rate",
    "pseudo_similarity_refusal_rate",
    "capability_drift_degradation_rate",
    "bad_feedback_resistance_rate",
    "quarantine_success_rate",
    "rollback_recovery_rate",
    "contaminated_evidence_rejection_rate",
    "negative_transfer_rate"
  ]
}
