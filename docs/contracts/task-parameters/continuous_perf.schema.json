{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mini-drop.local/contracts/task-parameters/continuous_perf.schema.json",
  "title": "Mini-Drop continuous_perf task parameters",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "target_pid",
    "duration_sec",
    "sample_rate"
  ],
  "properties": {
    "target_pid": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4194304
    },
    "duration_sec": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400,
      "default": 60
    },
    "sample_rate": {
      "type": "integer",
      "minimum": 1,
      "maximum": 999,
      "default": 49
    },
    "options": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "timeout_sec": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86700
        },
        "container_name": {
          "type": "string",
          "maxLength": 256
        },
        "container_type": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "event": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "callgraph": {
          "enum": [
            "fp",
            "dwarf",
            "lbr"
          ]
        },
        "window_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 900
        },
        "trigger_cpu_percent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "trigger_consecutive_samples": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "trigger_wait_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        },
        "retention_tier": {
          "enum": [
            "short",
            "standard",
            "extended"
          ]
        }
      },
      "default": {}
    }
  },
  "x-task-kind": "continuous_perf",
  "x-contract-version": "1.0.0"
}
