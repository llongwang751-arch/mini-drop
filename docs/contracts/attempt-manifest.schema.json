{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mini-drop.local/contracts/attempt-manifest.schema.json",
  "title": "Mini-Drop TaskAttempt Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "task_attempt_id",
    "profiler_type",
    "completed_at_unix_ms",
    "artifacts"
  ],
  "properties": {
    "schema_version": {"const": "mini-drop.attempt-manifest.v1"},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "task_attempt_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "profiler_type": {"type": "integer", "minimum": 1},
    "completed_at_unix_ms": {"type": "integer", "minimum": 1},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["artifact_type", "filename", "object_key", "size_bytes", "sha256"],
        "properties": {
          "artifact_type": {"type": "string", "minLength": 1},
          "filename": {"type": "string", "minLength": 1},
          "object_key": {"type": "string", "minLength": 1},
          "size_bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
