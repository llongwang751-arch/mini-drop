  "cards": [
    {
      "dot": "cyan",
      "title": "指令体很小",
      "items": [
        "任务指令描述采谁、怎样采与预算；gRPC 回执报告元数据。"
      ]
    },
    {
      "dot": "emerald",
      "title": "证据文件单独保存",
      "items": [
        "RAW 的格式按采集器变化；完整调用树另存，SQL 保存有界结果。"
      ]
    },
    {
      "dot": "amber",
      "title": "AI 接收另一路投影",
      "items": [
        "普通诊断读取脱敏统计；原始 profile 不作为模型输入。"
      ]
    }
  ]
