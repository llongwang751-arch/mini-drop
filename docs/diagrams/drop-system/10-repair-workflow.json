  "cards": [
    {
      "dot": "rose",
      "title": "隔离与工具边界",
      "items": [
        "profile_business_flow、read_source、test_patch 经 Go 校验后调用固定 RPC；API 无 Docker socket。",
        "容器 UID10001、只读根目录、512 MiB、1 CPU、64 进程、240 秒硬限。"
      ]
    },
    {
      "dot": "cyan",
      "title": "验证适用范围",
      "items": [
        "红绿与 sham 是通用 Python preset 的新增验证；旧 CRM/Saber 保留各自冻结回归。",
        "6 组 CPU 对照只证明登记输入下的组件基准，不代表生产 P95/P99。"
      ]
    },
    {
      "dot": "emerald",
      "title": "失败与最终交付",
      "items": [
        "最多 8 轮模型、12 次工具、2 次实际沙箱测试；失败在原预算内修正或结束。",
        "patch_bundle 标明 isolated_snapshot 与 production_deployed=false。"
      ]
    }
  ]
