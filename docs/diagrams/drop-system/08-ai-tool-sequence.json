  "cards": [
    {
      "dot": "rose",
      "title": "仅 agentscope 后端的私有通道",
      "items": [
        "启用 AI_AGENT_BACKEND=agentscope 才走此图；默认 legacy 在 Go 内循环。",
        "两个 Unix socket 校验 SO_PEERCRED；临时 capability 不交给模型。"
      ]
    },
    {
      "dot": "cyan",
      "title": "谁能看到什么",
      "items": [
        "普通诊断仅问题与化名统计，不发送 RAW、密钥、签名 URL。",
        "源码片段需另同意；运行时没有数据库或存储凭据。"
      ]
    },
    {
      "dot": "emerald",
      "title": "谁说了算",
      "items": [
        "编排与工具网关属于同一 Go 进程；Go 验权限、预算、事实。",
        "PG 保存可见检查点/回执；不盲重放未知 pending。"
      ]
    }
  ]
