# Mini-Drop 环境变量模板
# 复制为 .env 后根据需要修改，不要提交真实密钥
#
# 默认配置面向本地 demo，可直接 docker compose up + make demo。
# 生产/公网演示前请开启认证并设置随机密钥：
#   MINI_DROP_API_AUTH_ENABLED=1
#   MINI_DROP_GRPC_AUTH_ENABLED=1
#   MINI_DROP_API_KEY=<your-random-key>
#   MINI_DROP_GRPC_TOKEN=<your-random-token>

MINI_DROP_ENV=dev

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8191
MINI_DROP_API_AUTH_ENABLED=0
MINI_DROP_API_KEY=
# Go API 到 Python 分析服务的内部认证令牌。生产环境必须使用独立随机值。
MINI_DROP_INTERNAL_GATEWAY_TOKEN=mini-drop-internal-dev
# 反向代理终止 TLS 时生产环境设为 1，强制浏览器只通过 HTTPS 发送认证 Cookie。
MINI_DROP_COOKIE_SECURE=0
# 可选的多用户 RBAC 配置；设置后可替代单一 MINI_DROP_API_KEY。
# 角色：viewer / operator / approver / admin；资源列表支持 "*"。
# MINI_DROP_API_PRINCIPALS_JSON=[{"id":"operator-a","api_key":"replace-me","roles":["operator"],"agent_ids":["agent-a"],"service_ids":["service-a"],"environments":["staging"]}]
MINI_DROP_API_PRINCIPALS_JSON=
MINI_DROP_ARTIFACT_ROOT=/tmp/mini-drop
MINI_DROP_GRPC_AUTH_ENABLED=0
MINI_DROP_GRPC_TOKEN=
MINI_DROP_GRPC_SECURE=0
MINI_DROP_GRPC_CERT_FILE=
MINI_DROP_GRPC_KEY_FILE=
MINI_DROP_GRPC_PORT=50051
# Compose 中 API/gRPC/诊断 Worker 已拆分；仅本地单进程调试时设为 1。
MINI_DROP_EMBED_GRPC=0
MINI_DROP_EMBED_MAINTENANCE=0
# 默认不通过 gRPC 下发 MinIO 凭据；开启时服务端还会强制要求 TLS。
MINI_DROP_GRPC_DISTRIBUTE_MINIO_CREDENTIALS=0

# PostgreSQL
DATABASE_URL=postgresql+psycopg://mini_drop:mini_drop@postgres:5432/mini_drop

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_AGENT_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=mini_drop
MINIO_SECRET_KEY=mini_drop_secret
MINIO_BUCKET=mini-drop
MINIO_AUTO_CREATE_BUCKET=1
MINIO_SECURE=0

# AI Provider (可选，兼容 OpenAI / DeepSeek / 任意 OpenAI-compatible 服务)
MINI_DROP_AI_ENABLED=full
MINI_DROP_AI_PROVIDER=deepseek
MINI_DROP_AI_BASE_URL=https://api.deepseek.com
MINI_DROP_AI_API_KEY=
MINI_DROP_AI_MODEL=deepseek-v4-flash
MINI_DROP_NLP_ENABLED=true
MINI_DROP_RCA_ENABLED=true
MINI_DROP_SUMMARIZE_ENABLED=true

# AI 集群诊断资源范围（逗号分隔；留空表示不额外限制，生产建议显式配置）
MINI_DROP_ALLOWED_SERVICES=
# 可选：目标应用源码目录。Compose 会只读挂载到 /workspace-source，
# 用于将热点函数映射到 Python AST 行号；留空时默认扫描仓库 server 目录。
MINI_DROP_SOURCE_PATH=./server
# 可选：组内 ai_ops_v2 统一测试集压缩包。Compose 通过仓库只读挂载读取，
# 私有 Oracle 不烘焙进镜像，也不会进入 AI 规划上下文。
MINI_DROP_EXTERNAL_BENCHMARK_ARCHIVE=/app/benchmarks/external/ai_ops_v2-2.0.0-candidate.1-20260811.zip

# DeepSeek legacy aliases（仍兼容）
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Agent
AGENT_ID=agent_local_demo
AGENT_GRPC_ADDR=control-plane:50051
AGENT_HEARTBEAT_INTERVAL_SEC=5
# 独立 Analyzer 通过对象存储读取原始产物，Compose/生产环境必须开启。
AGENT_UPLOAD_ARTIFACTS=1
AGENT_GRPC_SECURE=0
AGENT_GRPC_CA_CERT=
AGENT_GRPC_TLS_SERVER_NAME=

# Analyzer Worker
MINI_DROP_ANALYZER_POLL_SEC=1
MINI_DROP_ANALYZER_LEASE_SEC=120
MINI_DROP_ANALYZER_MAX_RETRIES=3
MINI_DROP_ANALYZER_RETRY_DELAY_SEC=5
MINI_DROP_ANALYZER_MAX_INPUT_BYTES=2147483648

# 独立 AI 诊断推进 Worker
MINI_DROP_DIAGNOSIS_POLL_SEC=2

