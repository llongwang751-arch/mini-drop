# Mini-Drop strict replication configuration
# Copy to .env and replace secrets before production use.

MINI_DROP_ENV=dev

# PostgreSQL: shared task, event, artifact metadata and AI diagnosis state.
POSTGRES_DB=mini_drop
POSTGRES_USER=mini_drop
POSTGRES_PASSWORD=mini_drop
DATABASE_URL=postgresql+psycopg://mini_drop:mini_drop@postgres:5432/mini_drop

# MinIO: raw collector files and analyzer outputs.
MINIO_ENDPOINT=minio:9000
MINIO_AGENT_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=mini_drop
MINIO_SECRET_KEY=mini_drop_secret
MINIO_BUCKET=mini-drop
MINIO_AUTO_CREATE_BUCKET=1
MINIO_SECURE=0

# Go HTTP/SSE API authentication.
MINI_DROP_API_AUTH_ENABLED=0
MINI_DROP_API_KEY=
MINI_DROP_API_PRINCIPALS_JSON=

# Go API, C++ Control and C++ Agent gRPC authentication/TLS.
MINI_DROP_GRPC_AUTH_ENABLED=0
MINI_DROP_GRPC_TOKEN=
MINI_DROP_GRPC_SECURE=0
MINI_DROP_GRPC_CERT_FILE=/certs/server.crt
MINI_DROP_GRPC_KEY_FILE=/certs/server.key
MINI_DROP_GRPC_CA_FILE=/certs/ca.crt
MINI_DROP_GRPC_CLIENT_CERT_FILE=/certs/client.crt
MINI_DROP_GRPC_CLIENT_KEY_FILE=/certs/client.key
MINI_DROP_GRPC_REQUIRE_CLIENT_CERT=0
MINI_DROP_DIAGNOSTIC_AI_GRPC_SERVER_NAME=diagnosis-worker

# C++ Agent.
NATIVE_AGENT_ID=agent_native_cpp
AGENT_HEARTBEAT_INTERVAL_SEC=5
AGENT_GRPC_CA_CERT=/certs/ca.crt
AGENT_GRPC_CLIENT_CERT=/certs/agent.crt
AGENT_GRPC_CLIENT_KEY=/certs/agent.key

# Python Analyzer worker.
MINI_DROP_ANALYZER_POLL_SEC=1
MINI_DROP_ANALYZER_LEASE_SEC=120
MINI_DROP_ANALYZER_MAX_RETRIES=3
MINI_DROP_ANALYZER_RETRY_DELAY_SEC=5
MINI_DROP_ANALYZER_MAX_INPUT_BYTES=2147483648

# Python Drop Insight V2 worker, exposed only to the Go API over private gRPC.
MINI_DROP_DIAGNOSIS_POLL_SEC=2
MINI_DROP_EXPERIMENT_EVAL_INTERVAL_SEC=300
MINI_DROP_SCHEDULE_POLL_SEC=5
MINI_DROP_SOURCE_PATH=.

# Optional OpenAI-compatible model assistance. Rules remain the fallback.
MINI_DROP_AI_ENABLED=full
MINI_DROP_AI_PROVIDER=deepseek
MINI_DROP_AI_BASE_URL=https://api.deepseek.com
MINI_DROP_AI_API_KEY=
MINI_DROP_AI_MODEL=deepseek-chat
MINI_DROP_AGENT_FRAMEWORK=langgraph
MINI_DROP_AGENT_CHECKPOINT_BACKEND=postgres
MINI_DROP_AGENT_MEMORY_MAX_MESSAGES=24
MINI_DROP_AGENT_MEMORY_MAX_TOKENS=12000
MINI_DROP_AGENT_MEMORY_KEEP_TOKENS=6000
# Optional isolated demo target used by the in-product Fault Plaza.  The full
# local compose stack defaults this to http://python-hotspot:8081.
MINI_DROP_FAULT_LAB_URL=
MINI_DROP_AUTO_SCOPE_RETRY_SEC=15
MINI_DROP_NLP_ENABLED=true
MINI_DROP_RCA_ENABLED=true
MINI_DROP_SUMMARIZE_ENABLED=true
