# Runtime captures, process state, sandbox output and rehearsal recordings.
# Public summaries and screenshots live in docs/evidence; generate fresh Runner
# captures from core/fixtures rather than publishing a runtime working tree.
core/evidence/
*.pid
runner.state
*.sqlite
*.sqlite3
*.sqlite3-*
*.db
*.webm
*.mp4
*.pprof
*.hprof
*.jfr
*.perf.data
*.perf.data.old
*.perf-script
*.profile
*.prof
*.dump
*.fdata
*.folded
*.bin
*.elf
*.pprof.gz
*.hprof.gz
*.jfr.gz
*.folded.gz

# Explicit imported parser fixtures are disposable toy captures with a checked
# SHA-256/size manifest and a reproducible generator, never business profiles.
!analyzer/tests/fixtures/golden.folded
!analyzer/tests/fixtures/collected/*.pprof
!analyzer/tests/fixtures/collected/*.hprof
!analyzer/tests/fixtures/collected/*.jfr
!analyzer/tests/fixtures/collected/*.profile
!analyzer/tests/fixtures/collected/*.fdata
!analyzer/tests/fixtures/collected/*.folded
!analyzer/tests/fixtures/collected/*.bin
!analyzer/tests/fixtures/collected/*.elf
