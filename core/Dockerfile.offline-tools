# 在独立且不含凭据的构建上下文中提供已校验的官方v4.1工具归档。
# 基础镜像必须来自本发布core/Dockerfile的profiler-deps阶段，不能混用未知工具层。
ARG PROFILER_BASE=drop-core-profiler-deps:20261020.1
FROM ${PROFILER_BASE}
USER root
COPY tools-install.py /tmp/drop-tools-install.py
COPY async-profiler.tar.gz /tmp/async-profiler.tar.gz
RUN DROP_ASYNC_PROFILER_ARCHIVE=/tmp/async-profiler.tar.gz python3 /tmp/drop-tools-install.py && \
    rm /tmp/drop-tools-install.py /tmp/async-profiler.tar.gz && ldconfig
ENV ASPROF_EXECUTABLE=/opt/drop-tools/async-profiler/bin/asprof \
    PY_SPY_EXECUTABLE=/opt/drop-tools/venv/bin/py-spy \
    MEMRAY_EXECUTABLE=/opt/drop-tools/venv/bin/memray \
    PERF2BOLT_EXECUTABLE=/usr/bin/perf2bolt-16
USER 10001:10001
