                    ]
                  }
                },
                "volumeMounts": [
                  {
                    "name": "tmp",
                    "mountPath": "/tmp"
                  },
                  {
                    "name": "secrets",
                    "subPath": "database_url",
                    "mountPath": "/run/secrets/database_url",
                    "readOnly": true
                  },
                  {
                    "name": "secrets",
                    "subPath": "s3_access_key",
                    "mountPath": "/run/secrets/s3_access_key",
                    "readOnly": true
                  },
                  {
                    "name": "secrets",
                    "subPath": "s3_secret_key",
                    "mountPath": "/run/secrets/s3_secret_key",
                    "readOnly": true
                  }
                ],
                "readinessProbe": {
                  "exec": {
                    "command": [
                      "python",
                      "-m",
                      "drop_analyzer.health"
                    ]
                  },
                  "initialDelaySeconds": 15,
                  "periodSeconds": 15
                },
                "livenessProbe": {
                  "exec": {
                    "command": [
                      "python",
                      "-m",
                      "drop_analyzer.health"
                    ]
                  },
                  "initialDelaySeconds": 45,
                  "periodSeconds": 30
                }
              }
            ],
            "volumes": [
              {
                "name": "tmp",
                "emptyDir": {
                  "sizeLimit": "8Gi"
                }
              },
              {
                "name": "secrets",
                "secret": {
                  "secretName": "drop-runtime",
                  "defaultMode": 288,
                  "items": [
                    {
                      "key": "database_url",
                      "path": "database_url"
                    },
                    {
                      "key": "s3_access_key",
                      "path": "s3_access_key"
                    },
                    {
                      "key": "s3_secret_key",
                      "path": "s3_secret_key"
                    }
                  ]
                }
              }
            ],
            "affinity": {
              "podAntiAffinity": {
                "preferredDuringSchedulingIgnoredDuringExecution": [
                  {
                    "weight": 100,
                    "podAffinityTerm": {
                      "labelSelector": {
                        "matchLabels": {
                          "app.kubernetes.io/name": "analyzer-heap",
                          "app.kubernetes.io/part-of": "drop"
                        }
                      },
                      "topologyKey": "kubernetes.io/hostname"
                    }
                  }
                ]
              }
            },
            "nodeSelector": {
              "drop.io/high-memory": "true"
            },
            "tolerations": [
              {
                "key": "drop.io/high-memory",
                "operator": "Equal",
                "value": "true",
                "effect": "NoSchedule"
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "maintenance",
        "namespace": "drop"
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/name": "maintenance",
            "app.kubernetes.io/part-of": "drop"
          }
        },
        "strategy": {
          "type": "RollingUpdate",
          "rollingUpdate": {
            "maxUnavailable": 0,
            "maxSurge": 1
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app.kubernetes.io/name": "maintenance",
              "app.kubernetes.io/part-of": "drop"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "terminationGracePeriodSeconds": 45,
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 10001,
              "runAsGroup": 10001,
              "fsGroup": 10001,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "containers": [
              {
                "name": "maintenance",
                "image": "drop-ops:20261018.1",
                "envFrom": [
                  {
                    "configMapRef": {
                      "name": "drop-config"
                    }
                  }
                ],
                "env": [
                  {
                    "name": "DATABASE_URL_FILE",
                    "value": "/run/secrets/database_url"
                  },
                  {
                    "name": "S3_ACCESS_KEY_FILE",
                    "value": "/run/secrets/s3_access_key"
                  },
                  {
                    "name": "S3_SECRET_KEY_FILE",
                    "value": "/run/secrets/s3_secret_key"
                  },
                  {
                    "name": "ALERT_WEBHOOK_TOKEN_FILE",
                    "value": "/run/secrets/alert_webhook_token"
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "128Mi",
                    "ephemeral-storage": "128Mi"
                  },
                  "limits": {
                    "cpu": "200m",
                    "memory": "128Mi",
                    "ephemeral-storage": "512Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "volumeMounts": [
                  {
                    "name": "tmp",
                    "mountPath": "/tmp"
                  },
                  {
                    "name": "secrets",
                    "subPath": "database_url",
                    "mountPath": "/run/secrets/database_url",
                    "readOnly": true
                  },
                  {
                    "name": "secrets",
                    "subPath": "s3_access_key",
                    "mountPath": "/run/secrets/s3_access_key",
                    "readOnly": true
                  },
                  {
                    "name": "secrets",
                    "subPath": "s3_secret_key",
                    "mountPath": "/run/secrets/s3_secret_key",
                    "readOnly": true
                  },
                  {
                    "name": "secrets",
                    "subPath": "alert_webhook_token",
                    "mountPath": "/run/secrets/alert_webhook_token",
                    "readOnly": true
                  }
                ],
                "readinessProbe": {
                  "httpGet": {
                    "path": "/healthz",
                    "port": 9105
                  },
                  "initialDelaySeconds": 20,
                  "periodSeconds": 15
                }
              }
            ],
            "volumes": [
              {
                "name": "tmp",
                "emptyDir": {
                  "sizeLimit": "256Mi"
                }
              },
              {
                "name": "secrets",
                "secret": {
                  "secretName": "drop-runtime",
                  "defaultMode": 288,
                  "items": [
                    {
                      "key": "database_url",
                      "path": "database_url"
                    },
                    {
                      "key": "s3_access_key",
                      "path": "s3_access_key"
                    },
                    {
                      "key": "s3_secret_key",
                      "path": "s3_secret_key"
                    },
                    {
                      "key": "alert_webhook_token",
                      "path": "alert_webhook_token"
                    }
                  ]
                }
              }
            ],
            "affinity": {
              "podAntiAffinity": {
                "preferredDuringSchedulingIgnoredDuringExecution": [
                  {
                    "weight": 100,
                    "podAffinityTerm": {
                      "labelSelector": {
                        "matchLabels": {
                          "app.kubernetes.io/name": "maintenance",
                          "app.kubernetes.io/part-of": "drop"
                        }
                      },
                      "topologyKey": "kubernetes.io/hostname"
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "apiVersion": "autoscaling/v2",
      "kind": "HorizontalPodAutoscaler",
      "metadata": {
        "name": "api",
        "namespace": "drop"
      },
      "spec": {
        "scaleTargetRef": {
          "apiVersion": "apps/v1",
          "kind": "Deployment",
          "name": "api"
        },
        "minReplicas": 2,
        "maxReplicas": 8,
        "metrics": [
