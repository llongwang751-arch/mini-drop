# Drop的有界采集helper，普通Agent与浏览器不因此获得额外权限。
# 唯一可写sysfs接口仅用于BCC旧版单uprobe附加兼容，
# 对应不支持uprobe_multi的内核；tracefs目录仍只读挂载。
# 不授予mount、SYS_ADMIN、Docker socket或对象存储秘密。
# 先用apparmor_parser -r加载配置，再与compose.helper-uprobes.yml配合使用。
abi <abi/3.0>,
#include <tunables/global>

profile drop-collector-helper flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  network,
  capability,
  umount,
  deny mount,

  # 只读/执行不可变镜像，并检查已固定的目标进程命名空间。
  / r,
  /** rixm,
  /dev/null rw,
  /dev/zero rw,
  /dev/random r,
  /dev/urandom r,
  /tmp/ rw,
  /tmp/** rwk,
  /dev/shm/ rw,
  /dev/shm/** rwk,
  /var/lib/drop-helper/ rw,
  /var/lib/drop-helper/** rwk,
  /run/drop-helper/ rw,
  /run/drop-helper/** rwk,
  /run/drop-helper-incoming/ rw,
  /run/drop-helper-incoming/** rwk,
  /proc/[0-9]*/mem rw,

  # 允许列表不包含其他/sys写操作，只将此登记文件单独以可写方式绑定。
  /sys/kernel/tracing/uprobe_events rw,

  # 保留容器运行时停止/终止及跨UID采集器收尾所需操作。
  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (receive) peer=crun,
  signal (send,receive) peer=drop-collector-helper,
  signal (send) peer=drop-diagnostic-target,
  signal (send) peer=drop-agent-controller,
  ptrace (trace,tracedby,read,readby) peer=drop-collector-helper,
  ptrace (trace,read) peer=drop-diagnostic-target,
  ptrace (trace,read) peer=drop-agent-controller,

  deny /proc/sysrq-trigger rwklx,
  deny /proc/kcore rwklx,
  deny /sys/kernel/security/** rwklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
}
