# Load through the process environment or a private, untracked env file.
# Chat-model credentials remain configured separately through the existing AI settings.
SILICONFLOW_API_KEY=
MINI_DROP_RETRIEVAL_MODE=hybrid
MINI_DROP_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
MINI_DROP_EMBEDDING_DIMENSIONS=1024
MINI_DROP_RERANK_MODEL=Qwen/Qwen3-Reranker-4B
MINI_DROP_RERANK_ENABLED=true
MINI_DROP_CHROMA_HOST=127.0.0.1
MINI_DROP_CHROMA_PORT=8000
# For single-process local development, set MINI_DROP_CHROMA_PATH instead.
# Optional Grafana connector; requires a read-only token for one environment.
MINI_DROP_GRAFANA_URL=
MINI_DROP_GRAFANA_TOKEN=
MINI_DROP_GRAFANA_PROMETHEUS_UID=
MINI_DROP_GRAFANA_ENVIRONMENT=
