# 每台 Worker 各复制一份为 worker.env。
# 可按云厂商替换为就近的 Ubuntu 镜像站，以加速 Agent 镜像构建。
UBUNTU_MIRROR=http://mirrors.aliyun.com/ubuntu
AGENT_ID=linux-worker-1
AGENT_IP_ADDR=10.0.0.21
AGENT_GRPC_ADDR=10.0.0.10:50051
AGENT_HEARTBEAT_INTERVAL_SEC=5
# 必须等于 init-control-pki.sh 使用的 Control IP 或 DNS。
AGENT_GRPC_TLS_SERVER_NAME=10.0.0.10
AGENT_GRPC_SECURE=1

# Docker Compose 读取宿主机目录；每台机器只放自己的三份公开/客户端材料。
AGENT_CERT_DIR=./deploy/certs/agents/linux-worker-1

# systemd 裸机模式读取下面三项。Docker Compose 会固定映射为 /certs/*。
AGENT_GRPC_CA_CERT=/etc/mini-drop/certs/ca.crt
AGENT_GRPC_CLIENT_CERT=/etc/mini-drop/certs/agent.crt
AGENT_GRPC_CLIENT_KEY=/etc/mini-drop/certs/agent.key

MINI_DROP_GRPC_TOKEN=CHANGE_ME_SHARED_RANDOM_GRPC_TOKEN

MINIO_BUCKET=mini-drop
# Agent 不持有长期对象存储密钥；每个任务由 Go API 签发精确对象的短时 PUT URL。

AGENT_RESULT_OUTBOX_DIR=/var/lib/mini-drop-agent/outbox
AGENT_RESULT_OUTBOX_MAX_ENTRIES=256
NATIVE_AGENT_RUNNER_MAX_MEMORY_MB=1024
NATIVE_AGENT_RUNNER_MAX_OUTPUT_MB=256
