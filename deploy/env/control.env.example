# 复制为 control.env；所有 CHANGE_ME 值必须替换。
CONTROL_BIND_ADDRESS=0.0.0.0
# Internal ports should normally stay on loopback. Workers can reach them
# through a private network, VPN, or the deployment guide's SSH tunnels.
CONTROL_INTERNAL_BIND_ADDRESS=127.0.0.1
CONTROL_HTTP_PORT=80
CONTROL_HTTPS_PORT=443
CONTROL_GRPC_PORT=50051
CONTROL_MINIO_PORT=9000
# Loopback alias used by the host-networked interview Agent. Remote Workers
# must expose this same local port through their existing Control SSH tunnel.
INTERVIEW_DEMO_MINIO_PORT=19000
CONTROL_PUBLIC_IP=10.0.0.10
# init-control-pki.sh 的输出目录；必须包含 ca/server/client 证书。
CONTROL_CERT_DIR=./deploy/certs/control

POSTGRES_DB=mini_drop
POSTGRES_USER=mini_drop
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD

MINIO_ACCESS_KEY=mini_drop_worker
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET
MINIO_BUCKET=mini-drop
MINIO_IMAGE=minio/minio:RELEASE.2025-04-08T15-41-24Z
DEBIAN_MIRROR=
DEBIAN_SECURITY_MIRROR=
PIP_INDEX_URL=
UBUNTU_MIRROR=http://mirrors.aliyun.com/ubuntu
NPM_REGISTRY=
ALPINE_MIRROR=
# 必须是每台 Agent 本地都能访问的地址；浏览器下载已走 Server，不依赖此端点。
# 当前三机部署在每台 Worker 上把 127.0.0.1:19000 隧道到 Control MinIO；
# interview-demo Agent 则使用上面的 Control 本机 loopback 映射。
MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:19000
# Go API 用这个 host:port 签发 PUT URL。不要带 http:// 或 https://。
MINIO_AGENT_ENDPOINT=127.0.0.1:19000
MINIO_AGENT_SECURE=0
MINIO_PUBLIC_SECURE=0

MINI_DROP_API_KEY=CHANGE_ME_API_KEY
MINI_DROP_GRPC_TOKEN=CHANGE_ME_SHARED_RANDOM_GRPC_TOKEN
MINI_DROP_API_AUTH_ENABLED=1
MINI_DROP_GRPC_AUTH_ENABLED=1
MINI_DROP_GRPC_SECURE=1
MINI_DROP_GRPC_REQUIRE_CLIENT_CERT=1
MINI_DROP_GRPC_API_CLIENT_IDENTITY=mini-drop-control-client
MINI_DROP_PROCESS_SNAPSHOT_RETENTION_PER_AGENT=120
MINI_DROP_PROCESS_SNAPSHOT_MAX_AGE_SEC=30
MINI_DROP_ALLOWED_SERVICES=

# 独立 Analyzer Worker
MINI_DROP_ANALYZER_POLL_SEC=1
MINI_DROP_ANALYZER_LEASE_SEC=120
MINI_DROP_ANALYZER_MAX_RETRIES=3
MINI_DROP_ANALYZER_RETRY_DELAY_SEC=5

# AI 可先关闭完成基础链路联调，再填入 Provider 配置。
MINI_DROP_AI_ENABLED=off
MINI_DROP_AI_PROVIDER=deepseek
MINI_DROP_AI_BASE_URL=https://api.deepseek.com
MINI_DROP_AI_API_KEY=
MINI_DROP_AI_MODEL=deepseek-v4-flash
MINI_DROP_AGENT_FRAMEWORK=langgraph
MINI_DROP_AGENT_CHECKPOINT_BACKEND=postgres
MINI_DROP_AGENT_MEMORY_MAX_MESSAGES=24
MINI_DROP_AGENT_MEMORY_MAX_TOKENS=12000
MINI_DROP_AGENT_MEMORY_KEEP_TOKENS=6000
# 可选的面试故障实验室。仅在启用 interview-demo profile 时填写下列
# Compose 内网地址；严禁指向生产服务，服务端只允许调用固定 /faults/* 路径。
MINI_DROP_FAULT_LAB_URL=
MINI_DROP_FAULT_LAB_GO_URL=
MINI_DROP_FAULT_LAB_JAVA_URL=
MINI_DROP_FAULT_LAB_CPP_URL=
# The certificate CN must exactly equal this stable Agent ID. Issue it from the
# existing Control CA; never regenerate the CA merely to enable the demo.
INTERVIEW_DEMO_AGENT_ID=control-interview-demo-agent
INTERVIEW_DEMO_AGENT_CERT_DIR=./deploy/certs/control/agents/control-interview-demo-agent
INTERVIEW_DEMO_GO_PPROF_PORT=16060
MINI_DROP_GO_PPROF_ENDPOINT=http://127.0.0.1:16060/debug/pprof/profile
# Hard limits keep every page-triggered fault bounded on the Control host.
INTERVIEW_DEMO_CPU_LIMIT=1.0
INTERVIEW_DEMO_MEMORY_LIMIT=512m
INTERVIEW_DEMO_PIDS_LIMIT=128
INTERVIEW_DEMO_GO_CPU_LIMIT=0.65
INTERVIEW_DEMO_GO_MEMORY_LIMIT=192m
INTERVIEW_DEMO_GO_PIDS_LIMIT=64
INTERVIEW_DEMO_JAVA_CPU_LIMIT=0.65
INTERVIEW_DEMO_JAVA_MEMORY_LIMIT=512m
INTERVIEW_DEMO_JAVA_PIDS_LIMIT=128
INTERVIEW_DEMO_CPP_CPU_LIMIT=0.65
INTERVIEW_DEMO_CPP_MEMORY_LIMIT=192m
INTERVIEW_DEMO_CPP_PIDS_LIMIT=96
INTERVIEW_DEMO_RUNNER_MAX_MEMORY_MB=768
INTERVIEW_DEMO_RUNNER_MAX_OUTPUT_MB=128
MINI_DROP_AUTO_SCOPE_RETRY_SEC=15
MINI_DROP_NLP_ENABLED=false
MINI_DROP_RCA_ENABLED=false
MINI_DROP_SUMMARIZE_ENABLED=false
