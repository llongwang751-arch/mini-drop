{
  "uid": "drop-operations",
  "title": "Drop · Operations",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "Asia/Shanghai",
  "tags": [
    "drop",
    "operations"
  ],
  "panels": [
    {
      "id": 1,
      "title": "在线 Agent",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "drop-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "drop_agents_online",
          "refId": "A",
          "legendFormat": "{{job}} {{status}} {{kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "采集排队",
