COLLECTOR_HELPER_SOCKET=/run/drop-helper/control.sock
COLLECTOR_HELPER_AGENT_UID=10001
COLLECTOR_HELPER_AGENT_GID=10001
COLLECTOR_HELPER_WORK_DIR=/opt/drop-runtime/helper-spool/cache
COLLECTOR_HELPER_INCOMING_DIR=/opt/drop-runtime/helper-spool/incoming
COLLECTOR_HELPER_DISK_BYTES=2147483648
COLLECTOR_HELPER_REQUIRE_BOUNDED_FS=true
COLLECTOR_HELPER_RETENTION_SECONDS=86400
ALLOW_HOST_PROCESSES=true
ALLOWED_TARGET_UIDS=10001
ALLOW_HOST_RESOURCES=false
ALLOW_CONTAINERS=false
NATIVE_CONTROL_ROOT=/opt/drop-runtime/helper-spool/incoming/native-control
# Contains policy and tool paths only. Never copy Agent TLS/DB/S3 credentials.
