AGENT_ID=business-host-01
AGENT_HOSTNAME=business-host-01
DROP_SERVER_ADDRESS=drop-server.example.internal:50051
TLS_CA_FILE=/etc/drop/tls/ca.crt
TLS_CERT_FILE=/etc/drop/tls/agent.crt
TLS_KEY_FILE=/etc/drop/tls/agent.key
WORK_DIR=/var/lib/drop-agent
COLLECTOR_HELPER_SOCKET=/run/drop-helper/control.sock
# Agent and cooperative target processes must see the same incoming path as
# the helper. No helper state/cache or credentials are made group writable.
COLLECTOR_HELPER_INCOMING_DIR=/opt/drop-runtime/helper-spool/incoming
ALLOW_HOST_PROCESSES=true
ALLOWED_TARGET_UIDS=10001
ALLOW_HOST_RESOURCES=true
ALLOW_CONTAINERS=false
NATIVE_CONTROL_ROOT=/opt/drop-runtime/helper-spool/incoming/native-control
METRICS_LISTEN=127.0.0.1:9103
# Optional external tools must be absolute paths with verified SHA256:
# ASPROF_EXECUTABLE=/opt/drop-tools/async-profiler/bin/asprof
# ASPROF_SHA256=<verified sha256>
# PY_SPY_EXECUTABLE=/usr/local/bin/py-spy
# PY_SPY_SHA256=<verified sha256>

RUN_CONTROLLED_WORKLOAD=false
