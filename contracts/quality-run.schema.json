{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reviewed immutable quality execution summary",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "title", "category", "suite", "status", "started_at", "finished_at", "environment", "source_commit", "source_sha256", "provenance", "fixture_scope", "counts", "metrics", "checks", "limits"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"$ref": "#/$defs/id"},
    "title": {"type": "string", "minLength": 1, "maxLength": 120},
    "category": {"enum": ["business", "agent", "security", "protocol", "system", "performance", "release", "client"]},
    "suite": {"$ref": "#/$defs/id"},
    "status": {"enum": ["passed", "failed", "incomplete"]},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "environment": {"enum": ["windows_local", "linux_isolated", "github_ci", "production_bounded"]},
    "source_commit": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[a-f0-9]{40}$"}]},
    "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$", "description": "原始执行收据的SHA256；本记录是该收据的审阅投影，不替代独立编译来源证明。"},
    "provenance": {"enum": ["actual_execution", "imported_fixture"]},
    "fixture_scope": {"type": "string", "minLength": 1, "maxLength": 240},
    "counts": {
      "type": "object", "additionalProperties": false,
      "required": ["passed", "failed", "skipped", "total"],
      "properties": {
        "passed": {"type": "integer", "minimum": 0, "maximum": 10000000},
        "failed": {"type": "integer", "minimum": 0, "maximum": 10000000},
        "skipped": {"type": "integer", "minimum": 0, "maximum": 10000000},
        "total": {"type": "integer", "minimum": 1, "maximum": 10000000}
      }
    },
    "metrics": {"type": "array", "maxItems": 16, "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "label", "value", "unit"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "label": {"type": "string", "minLength": 1, "maxLength": 64},
        "value": {"type": ["number", "null"], "minimum": 0},
        "unit": {"enum": ["count", "ms", "s", "ratio", "percent", "bytes", "tokens", "multiple"]}
      }
    }},
    "checks": {"type": "array", "maxItems": 64, "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "label", "status", "detail"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "label": {"type": "string", "minLength": 1, "maxLength": 80},
        "status": {"enum": ["passed", "failed", "skipped"]}, "detail": {"type": "string", "maxLength": 240}
      }
    }},
    "limits": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 240}}
  },
  "$defs": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{7,79}$"}}
}
